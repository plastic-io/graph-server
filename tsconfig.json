{
  "compilerOptions": {
    "outDir": "./dist",
    "inlineSourceMap": true,
    "moduleResolution": "node",
    "module": "commonjs",
    // Without an explicit target TypeScript assumes ES3, and then spreading an
    // iterator such as `[...map.keys()]` compiles to array-like handling and
    // silently yields an empty array.  The Lambda runtime is Node 18, so there
    // is no reason to downlevel at all.
    "target": "es2019",
    "lib": [
      "es2019",
      "esnext.asynciterable"
    ]
  },
  // The shared CRDT package ships compiled JavaScript and its own types now
  // (PB-120), so it is an ordinary dependency rather than sources this project
  // has to compile for it.
  "include": [
    "src/**/*.ts"
  ]
}
